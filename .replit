modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["resend:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 5173

[[ports]]
localPort = 8084
externalPort = 3001

[[ports]]
localPort = 8085
externalPort = 8000

[[ports]]
localPort = 8086
externalPort = 8099

[[ports]]
localPort = 20127
externalPort = 9000

[[ports]]
localPort = 20581
externalPort = 4200

[[ports]]
localPort = 20582
externalPort = 6800

[[ports]]
localPort = 20583
externalPort = 6000

[[ports]]
localPort = 25655
externalPort = 3000

[[ports]]
localPort = 25656
externalPort = 3003

[[ports]]
localPort = 25657
externalPort = 5000

[[ports]]
localPort = 25658
externalPort = 8008

[[ports]]
localPort = 25659
externalPort = 8080

[nix]
channel = "stable-25_05"
