# ──────────────────────────────────────────────────────────────────────────────
# Gaméasù — Exemple de configuration d'environnement
#
# Copiez ce fichier en `.env` (non versionné) et renseignez les valeurs.
# Ne committez JAMAIS de vraie valeur secrète. En production, ces variables
# doivent être fournies via le gestionnaire de secrets de la plateforme
# d'hébergement (Replit Secrets), pas via un fichier versionné.
#
# Légende :  (requis)  variable indispensable au démarrage
#            (option)  fonctionnalité désactivée / dégradée si absente
# ──────────────────────────────────────────────────────────────────────────────

# ─── Identité produit ─────────────────────────────────────────────────────────
APP_NAME=Gaméasù
APP_TAGLINE_FR=Le pilotage d'entreprise nouvelle génération
APP_TAGLINE_EN=The operating system for modern organizations
APP_URL=                                  # (option) URL publique de l'ERP tenant

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=                             # (requis) postgres://user:pass@host:5432/db

# ─── Réseau / domaines ────────────────────────────────────────────────────────
PORT=8080                                 # (option) port d'écoute de l'API (défaut 8080)
NODE_ENV=development                       # development | production
MAIN_DOMAIN=                              # (option) domaine racine multi-tenant (ex. gameasu.com)
# URLs publiques utilisées pour construire les liens des emails (reset MDP, invitations).
# À défaut, l'app retombe sur REPLIT_DEV_DOMAIN / REPLIT_DOMAINS.
PUBLIC_BASE_URL=                          # (option) origine de l'ERP tenant (ex. https://erp.gameasu.com)
COCKPIT_PUBLIC_BASE_URL=                  # (option) origine du Cockpit plateforme (vide = partage PUBLIC_BASE_URL)
COCKPIT_URL=                              # (option) URL du Cockpit super-admin

# ─── Plans & facturation ──────────────────────────────────────────────────────
DEFAULT_PLAN_CODE=STARTER
BILLING_CURRENCY=XOF                       # FCFA
DEFAULT_BILLING_CYCLE=monthly
DEFAULT_SETUP_FEE=0

# ─── Stripe (paiement carte international) — (option) ─────────────────────────
STRIPE_SECRET_KEY=                        # sk_live_… / sk_test_… (backend uniquement)
STRIPE_WEBHOOK_SECRET=                    # whsec_… (vérification signature webhook)

# ─── CinetPay (Mobile Money Afrique de l'Ouest) — (option) ────────────────────
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=                      # clé de vérification HMAC des webhooks

# ─── Stockage cloud (Google Drive OAuth) — (option) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clé AES-256 (base64, 32 octets) chiffrant les tokens OAuth stockés en base.
# Générer : `openssl rand -base64 32`. NE JAMAIS committer la vraie valeur.
CLOUD_STORAGE_ENCRYPTION_KEY=

# ─── Stockage objet Replit (uploads) — (option) ──────────────────────────────
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ─── Email transactionnel — (option, fallback "preview" si absent) ────────────
RESEND_API_KEY=                           # fournisseur principal (Resend)
SENDGRID_API_KEY=                         # fournisseur alternatif (SendGrid)
EMAIL_FROM=Gaméasù <noreply@gameasu.com>
NOREPLY_EMAIL=noreply@gameasu.com
SUPPORT_EMAIL=support@gameasu.com
SALES_EMAIL=sales@gameasu.com
INFO_EMAIL=info@gameasu.com
TEAM_NOTIFICATION_EMAIL=                  # destinataire des notifications internes
GAMEASU_NOTIFY_EMAIL=                     # destinataire des alertes plateforme

# ─── Intelligence artificielle — (option) ────────────────────────────────────
OPENAI_API_KEY=                           # proxy IA Replit ou clé OpenAI
OPENAI_BASE_URL=

# ─── Observabilité — (option) ─────────────────────────────────────────────────
LOG_LEVEL=info                            # trace | debug | info | warn | error

# ─── Seed / démo — (option, développement uniquement) ─────────────────────────
SEED_DEMO_DATA=false
SEED_HISSADO_DEMO=false

# ─── Frontend (Vite — variables exposées au navigateur, JAMAIS de secret) ─────
VITE_APP_NAME=Gaméasù
VITE_APP_TAGLINE_FR=Le pilotage d'entreprise nouvelle génération
VITE_APP_TAGLINE_EN=The operating system for modern organizations
VITE_APP_URL=
VITE_COCKPIT_URL=
VITE_DEFAULT_PLAN_CODE=STARTER
VITE_STRIPE_PUBLISHABLE_KEY=              # pk_live_… / pk_test_… (clé publique, non secrète)
