# ─── Nexora — variables d'environnement ──────────────────────────
# Identité produit
APP_NAME=Nexora
APP_ENV=development
APP_URL=
APP_TAGLINE_FR=Le pilotage d'entreprise nouvelle génération
APP_TAGLINE_EN=The operating system for modern organizations

# Base de données (PostgreSQL)
DATABASE_URL=

# Auth / JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Plans & facturation
DEFAULT_PLAN_CODE=STARTER
BILLING_CURRENCY=XOF
DEFAULT_BILLING_CYCLE=monthly
DEFAULT_SETUP_FEE=0

# Email transactionnel (optionnel — fallback "preview" si absent)
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Nexora <hello@nexora.africa>
SUPPORT_EMAIL=support@nexora.africa
SALES_EMAIL=sales@nexora.africa

# ─── URLs publiques (liens des emails : réinitialisation MDP, invitations) ─────
# En production, renseigner ces variables pour que les liens des emails pointent
# vers les bons domaines (sinon fallback sur REPLIT_DEV_DOMAIN).
#   PUBLIC_BASE_URL          → origine de l'ERP tenant (ex. https://app.gameasu.com)
#   COCKPIT_PUBLIC_BASE_URL  → origine du Cockpit plateforme (ex. https://cockpit.gameasu.com)
# Le Cockpit étant servi sous le chemin /cockpit/, les liens super-admin sont
# construits comme `${COCKPIT_PUBLIC_BASE_URL}/cockpit/reset-password?token=...`.
# Si le Cockpit partage le domaine de l'ERP, laisser COCKPIT_PUBLIC_BASE_URL vide
# (il retombe alors sur PUBLIC_BASE_URL).
PUBLIC_BASE_URL=
COCKPIT_PUBLIC_BASE_URL=

# IA (optionnel — proxy Replit AI)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ─── Frontend (Vite) ──────────────────────────────────────────────
VITE_APP_NAME=Nexora
VITE_APP_TAGLINE_FR=Le pilotage d'entreprise nouvelle génération
VITE_APP_TAGLINE_EN=The operating system for modern organizations
VITE_DEFAULT_PLAN_CODE=STARTER
